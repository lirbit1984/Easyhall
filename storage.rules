rules_version = '2';

// ============================================================================
// EasyHall CRM — Storage Rules
// מסמכים (הצעות מחיר/חוזים בפורמט PDF) נשמרים תחת
// organizations/{orgId}/leads/{leadId}/documents/{fileName}, ומוגנים באותה
// בדיקת חברות בארגון שמשמשת את חוקי Firestore.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isOrgMember(orgId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function orgRole(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    match /organizations/{orgId}/leads/{leadId}/documents/{fileName} {
      allow read, write: if isOrgMember(orgId);
    }

    // לוגו האולם המוצג בהצעת מחיר/חוזה — כל חבר קורא, רק admin מעלה/מחליף.
    match /organizations/{orgId}/branding/{fileName} {
      allow read: if isOrgMember(orgId);
      allow write: if isOrgMember(orgId) && orgRole(orgId) == 'admin';
    }

    // מאגר קבצים ארגוני כללי (תעודות, ביטוח, תמונות וכו') — מנוהל רק בהגדרות,
    // שם הגישה כבר admin-only בצד הלקוח; גם כאן admin בלבד כהגנה כפולה.
    match /organizations/{orgId}/files/{fileName} {
      allow read: if isOrgMember(orgId);
      allow write: if isOrgMember(orgId) && orgRole(orgId) == 'admin';
    }

    // תמונת האירוע/הזוג המוצגת בהדר כרטיס הליד.
    match /organizations/{orgId}/leads/{leadId}/photo/{fileName} {
      allow read, write: if isOrgMember(orgId);
    }

    // תמונת פרופיל אישית — בעל הפרופיל בלבד. קריאה פתוחה לכל מחובר הייתה
    // אומרת שמשתמש מאולם אחד רואה תמונות של עובדי אולמות אחרים; כתובת
    // ההורדה שנשמרת על מסמך ה-member היא זו שמשמשת לתצוגה מול עמיתים.
    match /users/{uid}/profile/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
